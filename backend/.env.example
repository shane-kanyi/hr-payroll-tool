# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+psycopg2://hr_user:hr_password@db:5432/hr_payroll
POSTGRES_USER=hr_user
POSTGRES_PASSWORD=hr_password
POSTGRES_DB=hr_payroll

# Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# Bootstrap admin account - created automatically on container startup if it
# doesn't already exist (see backend/docker-entrypoint.sh / `flask create-admin`).
# DEV/DEMO CONVENIENCE ONLY. Change this password (or unset these vars and
# create the admin manually) before deploying anywhere real.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Payroll config (documented fully in docs/PAYROLL.md)
SOCIAL_SECURITY_RATE=0.06

# Leave engine config (documented fully in docs/LEAVE.md) - all optional,
# shown here with their defaults.
ANNUAL_LEAVE_DAYS_PER_YEAR=21
SICK_LEAVE_DAYS_PER_YEAR=10
LEAVE_MIN_NOTICE_BUSINESS_DAYS=3
LEAVE_ESCALATION_THRESHOLD_DAYS=3
LEAVE_TEAM_MIN_COVERAGE_RATIO=0.5